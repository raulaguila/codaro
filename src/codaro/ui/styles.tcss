Screen#_default { background: $background; }
ModalScreen { background: #080d14 70%; }
ModePicker { background: transparent; }
#conversation, #plan-steps, #question-dock, #mode-fields, #model-fields {
    scrollbar-size: 1 1; scrollbar-color: $primary 30%; scrollbar-background: $background; }
#brand { height: 1; width: 12; color: $text; text-style: bold; }
#session-header { height: 3; padding: 1 2 0 2; border-bottom: solid $primary 30%; }
#session { height: 1; width: 1fr; color: $text-muted; text-wrap: nowrap;
    text-overflow: ellipsis; }
#select-mode, #select-model { height: 1; min-height: 1; padding: 0;
    border: none; background: $background; color: $text-muted; text-style: none; }
#select-mode { width: 18; min-width: 12; background: $background; margin-left: 1; }
#select-model { width: auto; min-width: 8; max-width: 32; text-overflow: ellipsis;
    text-wrap: nowrap; }
#select-model:hover, #select-model:focus { background: $panel; color: $text; border: none; }
#select-mode:hover, #select-mode:focus { background: $panel; color: $text; border: none; }
#session.insecure { color: $warning; }
#conversation { width: 100%; height: 1fr; padding: 0 2; }
#welcome { height: auto; margin: 1 0; }
#welcome Static { height: auto; color: $text-muted; }
#composer { height: auto; padding: 0 2; }
#response-card { height: auto; }
#question-dock, #question-pause, #question-send { display: none; }
#question-dock { height: auto; max-height: 9; overflow-y: auto; }
#question-heading { height: auto; }
#question-details { height: 1; min-height: 1; width: 10; min-width: 10; border: none;
    padding: 0; background: $panel; color: $text-muted; }
#question-dock Static { height: auto; }
.question-label { color: $text-muted; }
#question-title { width: 1fr; max-height: 2; margin: 0; color: $text; }
#question-why { display: none; }
#question-options { height: auto; border: none; padding: 0; background: $panel; }
#question-options > .option-list--option-highlighted { background: $primary 15%;
    text-style: none; color: $text; }
.free-answer #question-options > .option-list--option-highlighted {
    background: $panel; color: $text-muted; }
.answering #response-card { border: round $primary 65%; padding: 0 1; background: $panel; }
.answering #entry { border: none; }
.answering #entry:focus-within { border: none; }
.answering #prompt { background: $panel; }
.answering #question-pause, .answering #question-send { display: block;
    height: 1; min-height: 1; width: 10; min-width: 8; border: none; padding: 0;
    margin-left: 1; text-style: none; background: $panel; color: $text-muted; }
.answering #question-send { background: $accent; color: $background; text-style: bold; }
.answering #question-send:hover { background: $accent-lighten-1; color: $background; }
.short-terminal #question-dock { max-height: 6; }
.short-terminal #question-title { margin-top: 0; }
.short-terminal .question-label, .short-terminal #question-why { display: none; }
.short-terminal .paused .question-label { display: block; }
#entry { height: auto; border-top: solid $primary; }
#entry:focus-within { border-top: solid $accent; }
#entry-mark { width: 2; height: 1; color: $accent; }
#prompt { height: 2; max-height: 8; width: 1fr; margin: 0; border: none; padding: 0;
    background: $background; }
#completion { display: none; height: auto; max-height: 8; width: 76; max-width: 100%;
    padding: 0 1; border: round $primary 40%; border-title-color: $text-muted;
    background: $surface; color: $text-muted; }
#completion { text-overflow: ellipsis; text-wrap: nowrap; }
#prompt-hint { height: 1; color: $text-muted; }
#composer-meta { height: 1; }
#context-meter { height: 1; width: auto; max-width: 42%; color: $text-muted;
    text-wrap: nowrap; text-overflow: ellipsis; text-align: right; }
#generation-rate { height: 1; width: auto; margin: 0 2; color: $text-muted; }
#new-messages { display: none; height: 1; min-height: 1; border: none; margin: 0 2; }
#status { height: 1; width: 1fr; color: $text-muted;
    text-wrap: nowrap; text-overflow: ellipsis; }
#execution-plan { display: none; height: auto; border-top: solid $primary 65%; }
#plan-heading { height: 1; }
#execution-plan Button { height: 1; min-height: 1; border: none; padding: 0;
    background: $background; color: $text-muted; text-style: none; }
#execution-plan Button:hover, #execution-plan Button:focus {
    background: $panel; color: $text; border: none; }
#toggle-plan { width: 1fr; text-align: left; content-align: left middle;
    text-wrap: nowrap; text-overflow: ellipsis; }
#cancel-plan { width: 16; min-width: 16; background: $panel; }
#follow-plan { display: none; width: 11; min-width: 11; }
#session-picker, #message-actions, #file-preview, #copy-preview {
    width: 90%; max-width: 90; height: 24; max-height: 85%;
    padding: 0 2; border: round $primary 35%; background: $surface;
}
#session-list, #message-action-list, #file-preview-code, #copy-preview-text {
    height: 1fr; border: none; }
#session-picker-info { height: 2; color: $text-muted; }
#session-picker Input { height: 1; margin: 0 0 1 0; }
#session-picker Checkbox { height: 1; margin: 0 0 1 0; }
#session-picker .dialog-actions Button { min-width: 7; }
#session-picker .dialog-actions #session-use { background: $accent; color: $background; }
#message-actions { height: auto; max-height: 85%; }
#message-action-list { height: auto; max-height: 14; }
#message-actions-close, #file-preview-close, #copy-preview-close, #message-copy-manual {
    height: 1; min-height: 1; width: auto; min-width: 12;
    padding: 0; border: none; background: $surface; color: $text; }
#message-copy-status { height: auto; color: $text-muted; }
#copy-preview > Static { height: auto; }
#file-preview, #copy-preview { height: 85%; }
.assistant:focus { background: $primary 10%; }
#plan-steps { height: auto; max-height: 5; padding-left: 2; }
#plan-list { height: auto; color: $text-muted; }
#execute-plan { width: auto; margin-top: 1; }
.recovery-actions { height: 1; margin: 1 0; }
.recovery-actions Button { width: 1fr; min-width: 8; padding: 0; }
#configure-start { height: 1; min-height: 1; width: auto; border: none; padding: 0; }
.question { height: auto; margin: 1 0; padding: 0 1; color: $text;
    width: 100%; max-width: 100; background: $primary 5%; border-left: solid $primary 35%; }
.decision { height: auto; width: 100%; max-width: 100; margin: 1 0; padding: 0 1;
    background: $background; border-left: solid $primary 35%; }
.assistant { margin: 0; padding: 0 1; background: $background; }
.archived-assistant { height: auto; max-width: 102; }
.assistant MarkdownParagraph, .assistant MarkdownH1, .assistant MarkdownH2,
.assistant MarkdownH3, .assistant MarkdownList, .assistant MarkdownBlockQuote,
.generation-text MarkdownParagraph, .generation-text MarkdownH1, .generation-text MarkdownH2,
.generation-text MarkdownH3, .generation-text MarkdownList { max-width: 100; }
.assistant MarkdownH1, .assistant MarkdownH2, .assistant MarkdownH3 { margin: 1 0 0 0; padding: 0; }
.assistant MarkdownParagraph, .assistant MarkdownList { margin: 0 0 1 0; }
.assistant MarkdownListItem MarkdownParagraph { margin: 0; }
.speaker { height: 1; margin: 1 1 0 1; color: $accent; text-style: bold; }
.tool-card { height: auto; margin: 0; border: none;
             padding: 0; }
.tool-card.error > CollapsibleTitle { color: $warning; }
.tool-card > CollapsibleTitle { color: $text-muted; background: $background; }
.tool-card > Contents { padding: 0 1; border-left: solid $primary 30%; margin-left: 1; }
.generation-previews { height: auto; }
.generation-preview { height: auto; border: none; padding: 0; }
.generation-preview > Contents { padding: 0 1; }
.generation-text { height: auto; color: $text; }
.generation-preview CollapsibleTitle { color: $text-muted; }
.reasoning-preview { margin: 0 1 1 1; }
.reasoning-preview > CollapsibleTitle { display: none; }
.reasoning-group { height: auto; border: none; margin: 0; padding: 0; }
.reasoning-group > CollapsibleTitle { color: $text-muted; }
.tool-card, .reasoning-group, .generation-preview { background: $background; }
.reasoning-group > CollapsibleTitle, .generation-preview > CollapsibleTitle {
    background: $background; }
.reasoning-preview .generation-text { color: $text-muted; text-style: italic;
                                     max-height: 8; overflow-y: auto; }
.response-preview { margin: 1 0; }
.response-preview.live-answer > CollapsibleTitle { display: none; }
.response-preview.live-answer > Contents { padding: 0 1; }
.live-speaker { height: 1; color: $accent; text-style: bold; margin-bottom: 1; }
.turn-stages { height: auto; margin: 0 1; }
.live-steps { height: auto; max-height: 2; padding-left: 2; color: $text-muted; }
.intermediate-step { height: auto; border: none; padding: 0; color: $text-muted; }
.intermediate-step > Contents { max-height: 8; overflow-y: auto; }
.timeline-tool { height: auto; color: $text-muted; margin: 0 0 1 0; }
.timeline-tool.error { color: $warning; }

.notice { height: auto; margin: 1; color: $warning; }
.notice.neutral { color: $text-muted; }
.recovery-card { height: auto; padding: 0; border: none; }
.recovery-card > CollapsibleTitle { color: $warning; }
.recovery-card.neutral > CollapsibleTitle,
.recovery-card.resolved > CollapsibleTitle { color: $text-muted; }
.recovery-card > Contents { padding: 0; }

/* Dialogs use the same quiet frame and fixed actions as the approved proposal. */
#review, #command-review, #preferences-form, #new-conversation, #provider-manager {
    border: round $primary 35%; background: $surface; }
#review { width: 90%; max-width: 100; height: 85%; }
#review-title { color: $text; padding: 0 2; }
#review-actions { height: 2; padding: 0; border-top: solid $primary 30%; }
#review-actions Button, #command-review Button, #preferences-actions Button,
#new-conversation Button, .profile-actions Button {
    height: 1; min-height: 1; border: none; background: $surface; color: $text-muted;
    text-style: none; }
#review-actions #apply-edit, #preferences-actions #preferences-save {
    background: $accent; color: $background; text-style: bold; }
#review-actions #reject-edit { color: $error; }
#preferences-actions { height: 2; border-top: solid $primary 30%; }

/* Shared compact forms and read-only views. Hover never changes the box model. */
DialogScreen { align: center middle; background: #080d14 70%; }
ModePicker { align: right top; background: transparent; }
#provider-form { height: 24; }
#model-form { height: 24; }
#provider-key-field, #provider-url-field { height: auto; }
#provider-fields Select, #provider-fields Input,
#model-fields Select, #model-fields Input { margin: 0 0 1 0; }
#provider-fields Input, #model-fields Input, #preferences-fields Input {
    background: $background; padding: 0 1; }
#provider-fields Input { height: 1; border: none; border-left: solid $primary 50%;
    background: $primary 10%; color: $text; }
#provider-fields Input:focus { border-left: solid $accent; background: $primary 20%; }
#provider-fields Input > .input--placeholder { color: $text-muted; }
#provider-fields Static, #model-fields Static { color: $text-muted; }
#provider-tls-warning { color: $warning; }
#provider-test-inference, #model-test { width: auto; color: $text; }
#provider-error, #model-error { color: $text-muted; max-height: 3; }
#provider-error.error, #model-error.error { color: $error; }
#provider-error.success, #model-error.success { color: $success; }
#provider-actions { align-horizontal: center; }
#provider-actions #provider-test { width: 17; min-width: 17; }
#provider-actions #provider-back { width: 10; min-width: 10; }
#provider-actions #provider-save { width: 19; min-width: 19; }
#model-list-state { height: 6; padding: 1; color: $text-muted; }
#model-details { height: auto; padding: 0; border: none; }
#model-details > Contents { padding: 0 1; }
#model-info { color: $text-muted; margin: 1 0; }
#model-test-warning { height: 1; text-wrap: nowrap; text-overflow: ellipsis; }
#model-id > .option-list--option-highlighted { background: $primary 25%;
    color: $text; text-style: bold; }
#model-id { scrollbar-size: 1 1; }
.short-terminal #model-form .dialog-title { margin: 0 0 1 0; }
.short-terminal #model-fields Select, .short-terminal #model-fields Input { margin: 0; }
.short-terminal #model-id { height: 5; }
.compact-terminal.short-terminal #model-id { height: 3; }
.short-terminal #model-info { margin: 0; max-height: 2; }
.dialog-title { height: auto; color: $text; text-style: bold; margin: 1 0; }
.muted { color: $text-muted; }
#details-dialog { width: 90%; max-width: 84; height: 24;
    max-height: 85%; padding: 0 2; border: round $primary 35%; background: $surface; }
#details-body { height: 1fr; scrollbar-size: 1 1; }
#details-body Static { height: auto; }
.detail-row { height: auto; min-height: 1; margin-bottom: 0; }
.detail-key { width: 24; color: $text-muted; }
.detail-value { width: 1fr; color: $text; }
.dialog-actions { height: 2; border-top: solid $primary 30%; padding-top: 0; }
.dialog-actions Button { width: 1fr; min-width: 8; padding: 0; height: 1;
    min-height: 1; border: none; background: $surface; color: $text-muted; text-style: none; }
.dialog-actions .-primary { background: $accent; color: $background; text-style: bold; }
#resume-dialog { width: 90%; max-width: 76; height: auto; max-height: 90%;
    padding: 0 2 1 2; border: round $primary 35%; background: $surface; }
#resume-dialog Static { height: auto; margin-bottom: 1; }
#resume-title { color: $text; text-style: bold; }
#resume-preview { max-height: 2; color: $text-muted; }
#features-form, #integration-form { width: 90%; max-width: 84; height: 24;
    max-height: 90%; padding: 0 2; border: round $primary 35%; background: $surface; }
#features-fields, #integration-fields { height: 1fr; scrollbar-size: 1 1; }
#features-fields Static, #integration-fields Static { height: auto; }
#features-fields Checkbox, #integration-fields Checkbox { height: 1; margin: 0; }
#features-fields Input, #integration-fields Input { height: 1; border: none;
    border-left: solid $primary 50%; padding: 0 1; background: $primary 10%; margin: 0 0 1 0; }
#features-fields Input:focus, #integration-fields Input:focus {
    border-left: solid $accent; background: $primary 20%; }
#integration-fields Select { margin: 0 0 1 0; }
#integration-field-command, #integration-field-url, #integration-field-plugin,
#integration-field-env, #integration-field-token, #integration-tools-group { height: auto; }
#features-advanced, #integration-advanced { height: auto; border: none; padding: 0; }
#features-advanced > Contents, #integration-advanced > Contents { padding: 0 1; }
.feature-description { height: auto; color: $text-muted; margin: 0 0 1 2; }
.feature-heading { color: $text; margin-top: 1; }
#features-json { max-height: 8; overflow-y: auto; color: $text-muted; }
#features-error, #integration-status { height: auto; max-height: 3; color: $text-muted; }
#features-error { color: $warning; }
#integration-status.error { color: $error; }
#integration-status.success { color: $success; }
#integration-tools { height: 4; border: none; padding: 0; scrollbar-size: 1 1; }
#integration-tool-description { max-height: 2; color: $text-muted; }
.short-terminal #features-form .dialog-title, .short-terminal #integration-form .dialog-title {
    margin: 0 0 1 0; }
.short-terminal #resume-dialog { padding: 0 2; }
.short-terminal #resume-dialog Static { margin-bottom: 0; }
.short-terminal .feature-description { margin: 0 0 0 2; }
#new-conversation { max-width: 76; padding: 0 2; }
#new-conversation Static { margin-bottom: 1; }
#new-conversation Horizontal { height: 2; border-top: solid $primary 30%; padding-top: 0; }
#begin-conversation { background: $accent; color: $background; text-style: bold; }
#review { height: 70%; max-height: 26; }
#review-actions Button { width: auto; margin: 0 1; }
#review-actions #apply-edit { min-width: 20; }
.recovery-actions Button, .outcome-actions Button { width: auto; min-width: 8;
    margin-right: 2; height: 1; min-height: 1; border: none; padding: 0;
    background: $background; color: $text-muted; text-style: none; }
.recovery-description { height: auto; color: $text-muted; }
.recovery-card > Contents > Collapsible { height: auto; border: none; padding: 0; }
.recovery-card > Contents > Collapsible > Contents { max-height: 8; overflow-y: auto; }
.outcome-actions { height: 1; margin: 1 1; }
.task-receipt { height: auto; margin: 1; }
.task-receipt Static { height: auto; color: $text-muted; }
.task-receipt.verified Static { color: $success; }
.task-receipt.failed Static { color: $warning; }
.plan-proposal { height: auto; margin: 1; }
.plan-proposal Static { height: auto; margin-bottom: 1; }
.plan-proposal #plan-start { background: $accent; color: $background; }
.welcome-title { color: $text; text-style: bold; margin: 1 0; }
.compact-terminal #context-meter { max-width: 30%; }

/* Commands only occupy space while owned processes are active. */
#job-strip { display: none; height: 1; margin-bottom: 0; }
#job-strip Button { height: 1; min-height: 1; border: none; padding: 0;
    background: $background; color: $text-muted; text-style: none; }
#jobs-open { width: 1fr; content-align: left middle; }
#jobs-stop { width: 8; min-width: 8; color: $warning; }
#job-strip Button:hover, #job-strip Button:focus { background: $panel; color: $text; }
#jobs-dialog { width: 95%; max-width: 96; height: 23; max-height: 90%; padding: 0 1;
    border: round $primary 35%; background: $surface; }
#jobs-list { height: 3; border: none; padding: 0; }
#job-state { height: auto; max-height: 2; color: $text-muted; }
#job-output { height: 1fr; min-height: 3; border: none; }
#jobs-dialog .dialog-actions Button { min-width: 7; }

Prompt .text-area--placeholder { color: $text-muted; text-style: none; }
.short-terminal #prompt { min-height: 1; }
.short-terminal .answering #prompt { height: 1; }
.short-terminal .answering #response-card { padding: 0 1; }
.short-terminal .question-label { display: none; }
.short-terminal .answering #question-dock { max-height: 6; }
.short-terminal #question-title { max-height: 1; }
#provider-storage-help { color: $text-muted; max-height: 3; }

#provider-manager { max-height: 90%; padding: 0 1; }
#provider-manager .dialog-title { margin: 1 0; }
.profile-actions { height: 2; }
.profile-row { margin-bottom: 0; }
#provider-manager > .profile-actions { border-top: solid $primary 30%; }
#scope-review { width: 95%; max-width: 90; height: 24; max-height: 90%;
    border: round $primary 35%; padding: 0 1; background: $surface; }
#scope-review .dialog-title { margin: 0; }
#scope-task { max-height: 1; text-wrap: nowrap; text-overflow: ellipsis; color: $text-muted; }
#scope-summary { height: 1; color: $text-muted; }
#scope-preview { display: none; }
#scope-fields TextArea { height: 3; border: none; border-left: solid $primary 45%;
    padding: 0 1; margin-bottom: 1; background: $primary 8%; }
#scope-fields #scope-json { height: 7; }
#scope-fields Checkbox { height: 1; margin: 0; }
#scope-review Horizontal { height: 2; border-top: solid $primary 30%; }
#scope-review Button { height: 1; min-height: 1; border: none; padding: 0;
    background: $surface; color: $text-muted; text-style: none; }
#scope-review #scope-details { width: auto; }
#scope-review #grant-scope { background: $accent; color: $background; }
#scope-review Button:hover, #scope-review Button:focus { background: $panel; color: $text; }
#scope-review #grant-scope:hover, #scope-review #grant-scope:focus {
    background: $accent-lighten-1; color: $background; }
#command-review .dialog-title { margin: 0 0 1 0; }
#command-review > Horizontal { height: 2; border-top: solid $primary 30%; }
.short-terminal .assistant MarkdownFence, .short-terminal .generation-text MarkdownFence {
    margin: 0 0 1 0; padding: 0; }
.short-terminal .assistant MarkdownList, .short-terminal .generation-text MarkdownList {
    margin: 0; padding: 0; }
.short-terminal .assistant MarkdownParagraph, .short-terminal .generation-text MarkdownParagraph {
    margin-bottom: 0; }
